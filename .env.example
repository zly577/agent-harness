# Docker Compose 配置位于根目录，与 backend/.env（本机开发）分开。
# 用 python deploy/init-env.py 自动生成密码和密钥。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
FERNET_KEY=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
ALLOW_REGISTRATION=true
# 开启后须配置 SMTP；关闭时可直接使用邮箱和密码注册。
REGISTRATION_EMAIL_VERIFICATION=false
WEB_BIND_IP=127.0.0.1
WEB_PORT=8088
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
MCP_ENABLED=true
# 联网搜索默认无需密钥：Bing RSS → DuckDuckGo → 全球 Bing → 360 → 百度。
# 可选：配置 Tavily 官方 API 后优先使用它（按供应商套餐计费），失败自动回退。
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=30
WEB_SEARCH_PROVIDER_TIMEOUT_SECONDS=5
# Docker 内不能使用宿主机的 127.0.0.1；例如 http://host.docker.internal:7890。
WEB_SEARCH_PROXY=
# Docker 默认部署 OpenSandbox；以下三项在标准 Compose 中固定为这些值。
# 保留字段供非标准部署参考；旧 .env 中的 false/宿主机地址不影响标准部署。
SANDBOX_ENABLED=true
SANDBOX_DOMAIN=opensandbox:8080
SANDBOX_PROTOCOL=http
SANDBOX_API_KEY=
SANDBOX_IMAGE=python:3.11

# 注册邮箱验证码（SMTP；587 使用 STARTTLS，465 使用 SSL）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
SMTP_STARTTLS=true

# 发件服务预设：custom / qq / 163 / 126 / tencent-enterprise /
# netease-enterprise / outlook / microsoft365。预设会覆盖上面的主机、端口和加密选项。
SMTP_PROVIDER=custom
SMTP_AUTH_MODE=auto
# 微软 OAuth：Outlook 使用 refresh token；Microsoft 365 也支持租户 ID + 应用密钥。
SMTP_OAUTH_TENANT=common
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
