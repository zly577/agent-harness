# Docker Compose 配置位于根目录，与 backend/.env（本机开发）分开。
# 用 python deploy/init-env.py 自动生成密码和密钥。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
FERNET_KEY=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
ALLOW_REGISTRATION=false
WEB_BIND_IP=127.0.0.1
WEB_PORT=8088
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
TAVILY_API_KEY=
MCP_ENABLED=false
# 代码执行需额外启用 OpenSandbox，详见部署文档。
SANDBOX_ENABLED=false
SANDBOX_DOMAIN=host.docker.internal:8080
SANDBOX_PROTOCOL=http
SANDBOX_API_KEY=
SANDBOX_IMAGE=python:3.11
