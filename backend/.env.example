# ===== DeepSeek / LLM（P1 起使用）=====
# 注意：真实密钥只放 .env（已 gitignore），本文件仅作模板
#
# ⚠️ P18 起**这组配置不再决定运行时用哪个模型**：
#    模型改成"每个用户自己配置"，在界面右上角「模型」里加（支持任意 OpenAI 兼容
#    服务与 Anthropic 协议服务），配置存在数据库里、密钥加密保存。
#    这里的值只作为**探针/测试**的兜底（`build_llm()` 无参调用），
#    以及早期版本"系统级供应商"的引导来源（那个机制已取消）。
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# LLM 流式调用块间超时（秒）。request_timeout 只管连接+首字节，管不住流式过程；
# 推理模型 reasoning 阶段卡住会永久 await 下一个 chunk。0=关闭（不推荐）
LLM_STREAM_CHUNK_TIMEOUT_SECONDS=300

# ===== 业务数据持久化（P2，MySQL 8.0）=====
# ⚠️ 把 CHANGE_ME 换成你自己的 MySQL 口令；本文件是模板，真实值只放 .env（已 gitignore）
MYSQL_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3306/agent_harness?charset=utf8mb4

# ===== 消息历史（P2，SQLite 单文件）=====
# SQLITE_PATH=backend/data/harness.sqlite   （默认值，可不填）

# ===== 上下文管理（P2）=====
# 注意：一条带工具调用的用户轮次通常产生 5~8 条消息（AI 工具调用 + ToolMessage），
# 阈值过小（如 12）会导致几乎每轮都触发摘要压缩。keep 建议为 max 的 1/3 左右。
CONTEXT_MAX_MESSAGES=80
CONTEXT_KEEP_MESSAGES=24

# ===== MCP（P7）=====
# 需先 `pip install mcp langchain-mcp-adapters` 且网络可达魔塔 MCP 端点
MCP_ENABLED=true
# 单个 MCP server 的连接超时（秒）
MCP_CONNECT_TIMEOUT_SECONDS=15
# 单个 MCP 工具【执行】超时（秒）。连接成功 ≠ 调用会返回：服务端迟迟不吐结果时，
# 没有这个上限会让 agent 的 tools 节点永久挂起。超时以 Error: 开头返回，供熔断器识别。0 = 关闭
MCP_TOOL_CALL_TIMEOUT_SECONDS=120

# ===== 工具失败/调用次数限制（P5）=====
# ① 工具熔断降级（默认启用，对【所有工具各自】生效）
#    每个工具独立计数：连续失败 N 次 → 进入冷却期，期间调用被直接跳过（不执行），
#    并提示模型换方法；冷却结束后自动放行【一次探测】：
#        探测成功 → 完全恢复（工具"挂一会儿又好了"能自动再用）
#        探测失败 → 重新进入冷却期（再等一个冷却期才能再探）
#    成功一次即清零（"连续"的含义）。
FAILURE_LIMIT_THRESHOLD=5              # 连续失败几次后熔断；0 = 关闭
FAILURE_LIMIT_COOLDOWN_SECONDS=60      # 冷却时长（秒），决定"多久之后允许再探"
FAILURE_LIMIT_RESET_TOOL=reset_tool_breakers   # 模型可主动调用的手动恢复工具；留空 = 不提供
FAILURE_LIMIT_TOOL=                    # 留空 = 所有工具各自熔断（推荐）；填工具名 = 只熔断它

# ② 调用次数上限（默认关闭）：库自带 ToolCallLimitMiddleware，数的是【调用次数】
#    （成功也算、成功不清零）。需要"用完 N 次就停"时把 THREAD_LIMIT 设为 N。
#    EXIT_BEHAVIOR: continue(降级) / error(抛异常) / end(立刻结束本轮)
TOOL_CALL_THREAD_LIMIT=0
TOOL_CALL_RUN_LIMIT=0
TOOL_CALL_LIMIT_TOOL=web_search
TOOL_CALL_LIMIT_EXIT_BEHAVIOR=continue

# 联网搜索默认无需密钥：Bing RSS → DuckDuckGo → 全球 Bing → 360 → 百度。
# 可选 Tavily 官方 API（按供应商套餐计费）；失败自动回退到无密钥搜索。
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=30
WEB_SEARCH_PROVIDER_TIMEOUT_SECONDS=5
WEB_SEARCH_PROXY=

# ===== 人工介入 / 审批（P8，可热插拔）=====
# 重启后的默认值；运行期可随时用 PUT /api/v1/hitl/config 切换（或在页头开关点一下）。
# P21 起审批范围 = **只有访问本机真实文件**（/mnt/** 的读 + 写）；
# 工作区 /workspace/** 属于"沙箱内的地盘"，读写真自由、不弹窗。
# true  = 访问本机文件先弹审批窗，点"同意"才执行
# false = 全程自动执行，不产生任何审批中断
HITL_ENABLED=true

# ===== 权限模式（P21，可热插拔）=====
# 重启后的默认值；运行期可随时用 PUT /api/v1/access/config 切换
#（前端顶栏「沙箱内 / 完全访问」按钮走的就是这个接口）。
# sandbox = 默认权限：文件落工作区，execute 进 OpenSandbox 容器；访问本机文件需审批
# full    = 完全访问：execute 直接在本机 shell 执行（deepagents LocalShellBackend）、
#           本机文件读写不再审批。⚠️ 没有任何隔离，只应在你信任的场景打开；
#           重启会自动回落 sandbox（危险档位不持久化）。
HARNESS_ACCESS_MODE=sandbox
# 本机 Windows 完全访问模式：auto 优先 PowerShell 7，其次 Windows PowerShell 5.1。
# 可选 auto / pwsh / powershell / cmd；修改后重启后端。Linux 容器仍使用 POSIX shell。
HARNESS_WINDOWS_SHELL=auto
# 对外部署设 false，禁止用户切换到后端进程内的 shell 执行模式。
HARNESS_ALLOW_FULL_ACCESS=true

# ===== OpenSandbox 执行沙箱（P11）=====
# 开启后：文件读写走本地磁盘（HARNESS_WORKSPACE，默认 <repo>/workspace），
#         execute 命令进 OpenSandbox 容器执行，产出文件自动拉回本地磁盘。
SANDBOX_ENABLED=true
# 执行前后是否做「本地 ↔ 沙箱」文件同步（推送改动进容器 / 拉回容器产出）
SANDBOX_SYNC_ENABLED=true

# --- OpenSandbox 服务地址（客户端必须能访问到这个地址）---
# 服务跑在本机：127.0.0.1:8080
# 服务跑在远端 Linux：填服务器 IP（需服务端监听 0.0.0.0），或走 SSH 隧道填本地端口
SANDBOX_DOMAIN=127.0.0.1:8080
SANDBOX_PROTOCOL=http
SANDBOX_API_KEY=

# --- 关键：客户端能不能直连沙箱容器？---
# true （默认，推荐）：执行命令/传文件全部经 OpenSandbox 服务端代理，
#                     客户端只需要能访问 SANDBOX_DOMAIN 一个地址。
#                     远端 Linux + docker 私有网段（容器 IP 客户端不可达）时必须用 true。
# false：SDK 向服务端索要容器直连地址后自己连 —— 仅适合同机部署或容器端口已映射出来。
SANDBOX_USE_SERVER_PROXY=true

# 额外请求头（JSON）。SDK 在 Linux/macOS 会自动带 OPEN-SANDBOX-CLIENT-IP，
# Windows 探测不到；服务端若依赖该头判定客户端网络，可手填：
# SANDBOX_HEADERS={"OPEN-SANDBOX-CLIENT-IP": "192.168.1.50"}

SANDBOX_IMAGE=python:3.11
SANDBOX_ROOT=/workspace
# 创建沙箱的 HTTP 超时（秒）。首次创建要拉 python:3.11 + opensandbox/execd 镜像，
# 30 秒必然不够；镜像已在本地时创建只需几秒。
SANDBOX_CREATE_TIMEOUT_SECONDS=300
# 本地磁盘读写的根目录（不填默认 <repo>/workspace）
# HARNESS_WORKSPACE=D:/Deepseek_Harness/agent-harness/workspace

# ===== 本机磁盘访问（P12）=====
# 目标：**默认环境 = 这台电脑**，只有 execute（跑代码）才进沙箱。
# true  = 文件工具除 /workspace 外，还能直接读写本机真实文件：
#         每个挂载点在模型侧是 `/mnt/<名称>/...`（如 /mnt/d/Deepseek_Harness/a.py = D:\Deepseek_Harness\a.py）。
#         execute 仍然只在 OpenSandbox 容器里跑（容器只镜像 /workspace）。
# false = 只有 /workspace 可见（P11 行为）。
HARNESS_MACHINE_ACCESS=true
# 挂载点：逗号分隔，`名称=路径` 或裸路径。留空 = 自动挂载本机所有存在的盘符（c=C:/、d=D:/ …）。
# 例：HARNESS_MACHINE_MOUNTS=d=D:/,home=C:/Users/Administrator,proj=D:/work/api
HARNESS_MACHINE_MOUNTS=
# 注意：P21 起挂载点的**读和写**都走人工审批（"要碰你电脑上的东西先问我"），
#       HITL_ENABLED=false 或把权限模式切到 full 都可关掉这层审批。
#
# ---- 方案 A：把挂载点只读挂载进沙箱容器（消除「容器里看不到 /mnt」的坑）----
# 不开这个开关时：`read_file /mnt/d/a.xlsx` 成功，但
#   `execute("python -c \"import pandas; pandas.read_excel('/mnt/d/a.xlsx')\"")` 必然失败，
#   而且 execute 的失败返回不带 `Error:` 前缀、也没有 status=error ⇒ 熔断器不计数
#   ⇒ 模型反复换招空转（实测一次任务里 execute 20 次 + MCP 19 次 + read_file 12 次）。
# true = 把每个挂载点**只读**挂到容器内的同一路径 /mnt/<名>：
#        read_file 与 execute 看到同一个文件、同一个路径字符串 ⇒ 上述故障从根上消失，
#        大文件也不再受 32MB 同步上限约束。
# 前提：① OpenSandbox 服务端与目标文件**同机**（远端 ECS 上没有你的 D 盘）；
#       ② 运行时（Docker/K8s）**支持 host mount**，否则创建容器会失败 ——
#          应用会记 ERROR 并退回无挂载容器（不会静默假装成功）。
SANDBOX_MOUNT_MACHINE_DIRS=false
# 挂载是否只读。**保持 true**：写本机文件只能走宿主 FS + 人工审批；
# 改成 false 会让容器绕过审批直接写本机文件，仅在你明确接受该风险时才改。
SANDBOX_MOUNT_READ_ONLY=true

# ===== 应用 =====
APP_ENV=development

# ============================================================================
# ===== P18：用户认证与多租户 =====
# ============================================================================
# 说明：以下四项**留空也能在开发环境跑起来** —— 应用会在 backend/data/.dev_secrets.json
#       里自动生成并长期复用（该目录已 gitignore，重启不会把所有人登出）。
#       但 APP_ENV 改成非 development 后，JWT_SECRET / FERNET_KEY 必须显式配置，
#       否则启动直接失败（宁可开不起来，也不能用"悄悄生成的密钥"上线）。

# --- JWT 签名密钥（HS256）---
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
# access token 有效期（分钟）。默认 1440 = 24 小时；前端收到 401 会自动回登录页。
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- 供应商 api_key 的对称加密主密钥（Fernet，44 字符 base64）---
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 丢失/更换这个密钥 = 库里已存的供应商密钥全部解不开（用户要重新填一遍），请备份。
FERNET_KEY=

# --- 注册与引导管理员 ---
# true  = 允许自助注册（开发期推荐）；false = 只有管理员能建用户
ALLOW_REGISTRATION=true
# 开启后须配置 SMTP；关闭时可直接使用邮箱和密码注册。
REGISTRATION_EMAIL_VERIFICATION=false
# 迁移时若 users 表为空则创建这个管理员，并把**存量会话/日志**归属到它。
# 不填 PASSWORD 会用固定默认值并打 WARNING —— 仅方便本机开箱，对外部署必须改。
BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=管理员

# --- CORS 允许来源（逗号分隔）---
# 以前是 allow_origins=["*"]；P18 收紧为白名单（用 Bearer token，不需要带 Cookie，
# 所以不开 allow_credentials）。上线改成真实前端域名，如 https://harness.example.com
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 注册邮箱验证码（SMTP；587 使用 STARTTLS，465 使用 SSL）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
SMTP_STARTTLS=true

# 发件服务预设：custom / qq / 163 / 126 / tencent-enterprise /
# netease-enterprise / outlook / microsoft365。预设会覆盖上面的主机、端口和加密选项。
SMTP_PROVIDER=custom
SMTP_AUTH_MODE=auto
# 微软 OAuth：Outlook 使用 refresh token；Microsoft 365 也支持租户 ID + 应用密钥。
SMTP_OAUTH_TENANT=common
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
